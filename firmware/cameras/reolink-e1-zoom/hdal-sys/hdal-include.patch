--- a/hd_videoenc.h
+++ b/hd_videoenc.h
@@ -239,12 +239,20 @@
 
+/* PATCH(hdal-sys): HDAL 2.00 keeps h26x and jpeg in one union at offset 4, so the struct is 44 bytes,
+ * not 52. hd_videoenc_get/set(OUT_ENC_PARAM) memset 44 bytes and copy 8 (jpeg) or 40 (h26x) to p+4
+ * (libhdal.so 2.00 @2ce38, @2df18). See HEADERS.md. */
 typedef struct _HD_VIDEOENC_OUT {
 	HD_VIDEO_CODEC  codec_type;         ///< codec type
-	HD_H26X_CONFIG  h26x;           ///< H26x config
-	HD_JPEG_CONFIG  jpeg;           ///< Jpeg config
+	union {
+		HD_H26X_CONFIG  h26x;           ///< H26x config
+		HD_JPEG_CONFIG  jpeg;           ///< Jpeg config
+	};
 } HD_VIDEOENC_OUT;
 
+/* PATCH(hdal-sys): same union as HD_VIDEOENC_OUT; 44 bytes in HDAL 2.00 (libhdal.so @2c638, @2d97c). */
 typedef struct _HD_VIDEOENC_OUT2 {
 	HD_VIDEO_CODEC  codec_type;         ///< codec type
-	HD_H26X_CONFIG  h26x;           ///< H26x config
-	HD_JPEG_CONFIG2 jpeg;           ///< Jpeg config
+	union {
+		HD_H26X_CONFIG  h26x;           ///< H26x config
+		HD_JPEG_CONFIG2 jpeg;           ///< Jpeg config
+	};
 } HD_VIDEOENC_OUT2;
