#!/bin/sh
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"
: "${MI360_SYSROOT:?Set MI360_SYSROOT to the extracted stock rootfs directory}"
workspace_dir=$(CDPATH= cd -- ../.. && pwd)
python3 "$workspace_dir/scripts/fetch-zig.py" >/dev/null
export PATH="$workspace_dir/.tools/zig:$PATH"
MI360_ZIG_SHA256=$(python3 - "$workspace_dir/.tools/zig/zig" <<'PY'
from pathlib import Path
import hashlib, sys
print(hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest())
PY
)
export MI360_ZIG_SHA256
# Keep objects from same-version distributor builds out of Zig's compiler cache.
export ZIG_GLOBAL_CACHE_DIR="$workspace_dir/.tools/zig-cache/$MI360_ZIG_SHA256"
export MI360_SYSROOT
target_dir=$(python3 - <<'PY'
import os
print(os.path.abspath(os.environ.get('CARGO_TARGET_DIR', 'target')))
PY
)
export CARGO_TARGET_DIR="$target_dir"
export MI360_HEADERS="$target_dir/sdk-headers"
if [ -n "${MI360_HEADER_SOURCE:-}" ]; then
  python3 scripts/headers.py --out "$MI360_HEADERS" --from-directory "$MI360_HEADER_SOURCE"
else
  python3 scripts/headers.py --out "$MI360_HEADERS"
fi
case "$(rustc --version)" in
  'rustc 1.95.0 '*) ;;
  *) echo 'Build recipe requires Rust1.95.0 and matching rust-src' >&2; exit 1;;
esac
[ "$(zig version)" = 0.17.0 ] || { echo 'Build recipe requires Zig0.17.0' >&2; exit 1; }
python3 - <<'PY'
from pathlib import Path
import hashlib,json,os
lib=Path(os.environ['MI360_SYSROOT'])/'lib'
for name,digest in json.loads(Path('toolchain/libraries.json').read_text()).items():
    if hashlib.sha256((lib/name).read_bytes()).hexdigest()!=digest:
        raise SystemExit('Target library does not match the pinned build: '+name)
PY
export RUSTC_BOOTSTRAP=1
export RUSTFLAGS='-C target-feature=-soft-float,+fpxx,+nooddspreg -C relocation-model=pic'
export CARGO_TARGET_MIPSEL_UNKNOWN_LINUX_UCLIBC_LINKER="$repo_dir/scripts/mips-linker.py"
cargo build --locked -p mi360-cam -Zbuild-std=std,panic_abort --release --target mipsel-unknown-linux-uclibc "$@"
python3 toolchain/elf_compat.py "$target_dir/mipsel-unknown-linux-uclibc/release/mi360-cam" --report "$target_dir/elf-compat.json"
